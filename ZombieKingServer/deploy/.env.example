# Linux 部署(docker-compose)环境变量模板；本地 Windows 开发密钥由 scripts/dev/dev.env 管理（勿提交仓库）
# ---- 数据库 / Nakama 核心密钥 ----
ZK_DB_NAME=zombieking
ZK_DB_USER=nakama
ZK_DB_PASSWORD=CHANGE_ME
ZK_SOCKET_SERVER_KEY=CHANGE_ME
ZK_SESSION_ENCRYPTION_KEY=CHANGE_ME
ZK_REFRESH_ENCRYPTION_KEY=CHANGE_ME
ZK_CONSOLE_USERNAME=zk_console
ZK_CONSOLE_PASSWORD=CHANGE_ME
ZK_CONSOLE_SIGNING_KEY=CHANGE_ME
ZK_RUNTIME_HTTP_KEY=CHANGE_ME
SECRET_MASTER_KEY=CHANGE_ME
DEV_MODE=false

# ---- DS 调度内部通道 ----
# Nakama ↔ DS Manager 服务 Token（64 hex）
ZK_SERVICE_TOKEN=CHANGE_ME
# DS 主机预置密钥表：host_id=secret 逗号分隔（与每台 agent 的 ZK_AGENT_HOST_SECRET 对应）
ZK_DS_HOST_SECRETS=CHANGE_ME
# 可疑主机隔离阈值（结算复验失败累计达到即 isolated）
ZK_SUSPICIOUS_LIMIT=3

# ---- ds-agent（容器一体化部署时用；生产多主机建议 agent 直接跑在 DS 主机 systemd） ----
ZK_AGENT_HOST_ID=ds-host-1
ZK_AGENT_HOST_SECRET=CHANGE_ME
ZK_AGENT_HOST_IP=ds-agent
# DS 启动命令模板（占位符 {match_id} {ds_id} {port} {ds_secret} {players_file}）
ZK_DS_COMMAND=/ds/ZombieKingServer -log -port={port} -matchId={match_id} -dsId={ds_id} -dsSecret={ds_secret}
# UE5 专用服务器二进制目录（挂载到容器 /ds）
ZK_DS_BIN_DIR=./ds-bin

# ---- TLS（nginx 反代终止；证书目录含 fullchain.pem + privkey.pem） ----
ZK_TLS_CERT_DIR=./tls

# ---- 备份（scripts/deploy/backup-db.sh 读取） ----
ZK_BACKUP_DIR=/var/backups/zombieking
ZK_BACKUP_KEEP_DAYS=14
